# ===== Python env / caches =====
venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
.ipynb_checkpoints/

# ===== Archives / model zips (Kaggle downloads) =====
*.zip
*.tar.gz
data/*.gz
data/*.zip
data/models_retrain/_archive/

# ===== Processed data arrays (~30GB raw/graphs/features; regen from raw or Kaggle) =====
#   Small authoritative artifacts stay TRACKED: data/models_retrain/*.pt, data/pernode/, data/splits/
data/processed/*.npy
data/processed/*.json
data/processed/_superseded_graphs/

# ===== Attribution head-map images (regenerable, large) =====
results/**/labels/*.png
# Root-level report figures (figures/*.png) are tracked natively -- every exhibit now
# lives directly under figures/ by exhibit number. Anything else placed under figures/
# (working subdirectories, scratch output) stays ignored by default.
# docs/FIGURE_ROUND9.md §4: figures/drawio_sources/ holds the editable sources for the
# hand-drawn diagrams and must stay tracked -- it needs its own exception, since a
# blanket "/figures/*" rule hides everything under figures/ from git, including new
# subdirectories, until explicitly un-ignored (this is what swallowed figures/tables/
# unnoticed for two rounds).
/figures/*
!/figures/*.png
!/figures/drawio_sources/
!/figures/drawio_sources/**
# docs/FIGURE_ROUND10.md §3: figures/archive/ holds cut exhibits (archived, not deleted,
# so a cut can be reversed) and must stay tracked for the same reason drawio_sources does.
!/figures/archive/
!/figures/archive/**

# ===== Audit scratch (local tooling + inventories) =====
_project_audit/

# ===== Superseded caches (out of repo) =====
results/loss_curves.npz
results/best_model.pt
results/history_superseded/oldweight_ens_scores/
results/history_topology/
topo_features/
archive/scaffolding/checkpoints/

# ===== web_demo (SzScan) =====
web_demo/cache/
web_demo/backend/.env
web_demo/backend/szscan.db
web_demo/frontend/node_modules/
web_demo/frontend/dist/
